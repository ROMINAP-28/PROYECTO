# =============================================================================
# TRAVELINK - Variables de Entorno de Base de Datos (Plantilla de Ejemplo)
# =============================================================================

# TRAVELINK - Configuracion LOCAL de Docker

# Base de datos
DB_URL=jdbc:mysql://db:3306/DBTravelink?useSSL=false&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=UTF-8&serverTimezone=America/Lima

DB_USERNAME=root
DB_PASSWORD=CAMBIAR_CONTRASENA_LOCAL

# MySQL Docker
MYSQL_DATABASE=DBTravelink
MYSQL_ROOT_PASSWORD=CAMBIAR_CONTRASENA_LOCAL

