{
    "java.project.sourcePaths": [
        "backend/springboot/src/main/java"
    ],
    "java.project.referencedLibraries": [
        "backend/springboot/lib/**/*.jar"
    ],
    "java.project.outputPath": "backend/springboot/bin",
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.compile.nullAnalysis.mode": "automatic",
    "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx8G -Xms100m -Xlog:disable",
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/*.class": true,
        "**/bin": true,
        "**/target": true,
        "**/*.iml": true,
        "**/.idea": true
    }
}
