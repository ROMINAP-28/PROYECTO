<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">

    <!-- Configuración de Servidores y Credenciales con Variables de Entorno -->
    <servers>
        <server>
            <id>github</id>
            <username>${env.GH_ACTOR}</username>
            <password>${env.GH_TOKEN}</password>
        </server>
        <server>
            <id>travelink-internal-repo</id>
            <username>${env.NEXUS_USER}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>
    </servers>

    <!-- Espejos de Repositorios Centrales -->
    <mirrors>
        <mirror>
            <id>central-mirror</id>
            <name>Maven Central Public Mirror</name>
            <url>https://repo.maven.apache.org/maven2</url>
            <mirrorOf>central</mirrorOf>
        </mirror>
    </mirrors>

    <!-- Perfiles de Distribución -->
    <profiles>
        <profile>
            <id>corporate-repo</id>
            <repositories>
                <repository>
                    <id>central</id>
                    <url>https://repo.maven.apache.org/maven2</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>false</enabled></snapshots>
                </repository>
            </repositories>
        </profile>
    </profiles>

    <activeProfiles>
        <activeProfile>corporate-repo</activeProfile>
    </activeProfiles>
</settings>
