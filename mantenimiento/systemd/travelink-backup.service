[Unit]
Description=TRAVELINK - Backup Diario de Base de Datos MySQL
After=network.target docker.service

[Service]
Type=oneshot
User=travelink
Group=travelink
EnvironmentFile=-/etc/travelink/travelink.env
ExecStart=/bin/bash /opt/travelink/mantenimiento/scripts/backup.sh
StandardOutput=journal
StandardError=journal
PrivateTmp=true

[Install]
WantedBy=multi-user.target
