{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "ESTADO GENERAL Y KPIs DE NEGOCIO",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Estado de la App (Health)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "up{job=\"travelink-app\"}",
          "legendFormat": "Estado"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "id": 2,
      "title": "Uptime (Tiempo Activo)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "process_uptime_seconds{job=\"travelink-app\"}",
          "legendFormat": "Uptime"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "blue", "value": null }] } }
      }
    },
    {
      "id": 3,
      "title": "Reservas Creadas (Total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "travelink_reservas_creadas_total",
          "legendFormat": "Reservas"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "thresholds": { "steps": [{ "color": "green", "value": null }] } }
      }
    },
    {
      "id": 4,
      "title": "Reservas Canceladas (Total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "travelink_reservas_canceladas_total",
          "legendFormat": "Canceladas"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "thresholds": { "steps": [{ "color": "orange", "value": null }] } }
      }
    },
    {
      "id": 5,
      "title": "Logins Fallidos (Seguridad)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "travelink_auth_logins_fallidos_total",
          "legendFormat": "Fallidos"
        }
      ],
      "fieldConfig": {
        "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }
      }
    },
    {
      "id": 6,
      "title": "Throughput HTTP Actual",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"travelink-app\"}[1m]))",
          "legendFormat": "Peticiones/seg"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "thresholds": { "steps": [{ "color": "purple", "value": null }] } }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "RENDIMIENTO HTTP Y TIEMPOS DE RESPUESTA",
      "type": "row"
    },
    {
      "id": 10,
      "title": "Tasa de Peticiones HTTP por Código de Estado (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"travelink-app\"}[1m]))",
          "legendFormat": "Status {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 15, "lineWidth": 2 } }
      }
    },
    {
      "id": 11,
      "title": "Latencia de Respuestas HTTP (p50, p95, p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{job=\"travelink-app\"}[1m])) by (le))",
          "legendFormat": "p99 (Percentil 99)"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"travelink-app\"}[1m])) by (le))",
          "legendFormat": "p95 (Percentil 95)"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{job=\"travelink-app\"}[1m])) by (le))",
          "legendFormat": "p50 (Mediana)"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "MÉTRICAS INTERNAS DE LA JVM (JAVA 17)",
      "type": "row"
    },
    {
      "id": 20,
      "title": "Uso de Memoria Heap (Used vs Committed vs Max)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "jvm_memory_used_bytes{area=\"heap\", job=\"travelink-app\"}", "legendFormat": "Heap Usada" },
        { "expr": "jvm_memory_committed_bytes{area=\"heap\", job=\"travelink-app\"}", "legendFormat": "Heap Asignada" },
        { "expr": "jvm_memory_max_bytes{area=\"heap\", job=\"travelink-app\"}", "legendFormat": "Heap Máxima" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "fillOpacity": 15 } }
      }
    },
    {
      "id": 21,
      "title": "Hilos Activos de la JVM y Conexiones HikariCP",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "jvm_threads_live_threads{job=\"travelink-app\"}", "legendFormat": "Hilos JVM Vivos" },
        { "expr": "jvm_threads_daemon_threads{job=\"travelink-app\"}", "legendFormat": "Hilos Daemon" },
        { "expr": "hikaricp_connections_active", "legendFormat": "Conexiones DB Activas" }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2 } }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 103,
      "title": "SISTEMA OPERATIVO Y CONTENEDORES DOCKER",
      "type": "row"
    },
    {
      "id": 30,
      "title": "Uso de CPU por Contenedor (cAdvisor)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"travelink.*\"}[1m])) * 100",
          "legendFormat": "Contenedor: {{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "custom": { "fillOpacity": 10 } }
      }
    },
    {
      "id": 31,
      "title": "Memoria de Contenedores en Ejecución",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{name=~\"travelink.*\"}",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10 } }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "id": 104,
      "title": "REGISTROS EN TIEMPO REAL (LOKI LOGQL)",
      "type": "row"
    },
    {
      "id": 40,
      "title": "Consola de Logs Centralizada - TRAVELINK (Loki LogQL)",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 33 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "{job=~\"travelink.*\"}",
          "legendFormat": ""
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "refresh": "5s",
